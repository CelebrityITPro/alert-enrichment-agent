# Copy to .env and fill in. .env is gitignored - never commit real keys.

# --- Mode ---
# fixtures = read alerts from ./fixtures (no lab needed); wazuh = poll live Wazuh indexer
PIPELINE_MODE=fixtures

# --- Wazuh indexer (Phase 1+) ---
WAZUH_INDEXER_URL=https://localhost:9200
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=

# --- Threat intel (Phase 3) - free tiers ---
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
OTX_API_KEY=
ABUSECH_AUTH_KEY=
MISP_URL=
MISP_API_KEY=

# --- LLM (Phase 5) ---
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=

# --- Outputs (Phase 6) ---
DISCORD_WEBHOOK_URL=
IRIS_URL=
IRIS_API_KEY=
