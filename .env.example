# Copy to .env and fill in. .env is gitignored - never commit real keys.

# --- Mode ---
# fixtures = read alerts from ./fixtures (no lab needed); wazuh = poll live Wazuh indexer
PIPELINE_MODE=fixtures
# DEBUG shows cache hits/misses and one line per alert; INFO shows only a run summary
LOG_LEVEL=INFO

# --- Wazuh indexer (Phase 1+) ---
WAZUH_INDEXER_URL=https://localhost:9200
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=

# --- Threat intel (Phase 3) - free tiers ---
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
OTX_API_KEY=
ABUSECH_AUTH_KEY=
# Free MaxMind GeoLite2 City database (download needs a free MaxMind account).
# Used for impossible-travel detection; if the file is missing, that check is skipped.
GEOIP_DB_PATH=data/geo/GeoLite2-City.mmdb
MISP_URL=
MISP_API_KEY=

# --- LLM (Phase 5) ---
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=

# --- Outputs (Phase 6) ---
DISCORD_WEBHOOK_URL=
IRIS_URL=
IRIS_API_KEY=
